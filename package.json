{
	"name": "goldsrc-query",
	"version": "1.1.4",
	"description": "Query library for GoldSrc servers using the A2S UDP query protocol and RCON UDP protocol",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist/",
		"src/"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"check": "biome check --write",
		"check:ci": "biome check",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"prepublishOnly": "npm run check:ci && npm run build && npm test",
		"prepare": "husky"
	},
	"keywords": [
		"goldsrc",
		"half-life",
		"counter-strike",
		"valve",
		"server-query",
		"a2s",
		"rcon",
		"gameserver"
	],
	"author": "Omar Hindawi",
	"license": "MIT",
	"engines": {
		"node": ">=20.12.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@types/node": "^26.1.1",
		"husky": "^9.1.7",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}

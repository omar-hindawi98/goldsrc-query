{
  "name": "goldsrc-query",
  "version": "1.0.0",
  "description": "Query library for GoldSrc servers using the A2S UDP query protocol and RCON TCP protocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prepublishOnly": "npm run format:check && npm run build && npm test"
  },
  "keywords": [
    "goldsrc",
    "half-life",
    "counter-strike",
    "valve",
    "server-query",
    "a2s",
    "rcon",
    "gameserver"
  ],
  "author": "Omar Hindawi",
  "license": "ISC",
  "engines": {
    "node": ">=20.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
